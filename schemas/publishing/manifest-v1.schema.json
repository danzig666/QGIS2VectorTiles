{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danzig666/QGIS2VectorTiles/schemas/publishing/manifest-v1.schema.json",
  "title": "Public web-map manifest (manifest.json)",
  "type": "object",
  "required": [
    "schemaVersion",
    "publicationId",
    "releaseId",
    "title",
    "vectorOnly",
    "style",
    "sources",
    "view",
    "groups",
    "layers",
    "rules",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "publicationId": {
      "type": "string",
      "format": "uuid"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^r-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "locale": {
      "enum": [
        "en",
        "hu"
      ]
    },
    "attribution": {
      "type": "string"
    },
    "logo": {
      "type": [
        "string",
        "null"
      ]
    },
    "vectorOnly": {
      "const": true
    },
    "style": {
      "$ref": "#/$defs/relPath"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "tileType",
          "href",
          "minTileZoom",
          "maxTileZoom"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "pmtiles",
              "xyz"
            ]
          },
          "tileType": {
            "enum": [
              "mvt",
              "png",
              "jpeg",
              "webp"
            ]
          },
          "href": {
            "$ref": "#/$defs/relPath"
          },
          "minTileZoom": {
            "type": "integer",
            "minimum": 0
          },
          "maxTileZoom": {
            "type": "integer",
            "minimum": 0
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "sha256": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer"
          },
          "role": {
            "const": "raster"
          },
          "tileSize": {
            "type": "integer"
          },
          "layerId": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "role"
              ]
            },
            "then": {
              "properties": {
                "tileType": {
                  "enum": [
                    "png",
                    "jpeg",
                    "webp"
                  ]
                },
                "kind": {
                  "const": "pmtiles"
                },
                "id": {
                  "pattern": "^q2vt_raster_"
                }
              }
            },
            "else": {
              "properties": {
                "tileType": {
                  "const": "mvt"
                }
              }
            }
          }
        ]
      }
    },
    "view": {
      "type": "object",
      "required": [
        "center",
        "zoom"
      ],
      "additionalProperties": false,
      "properties": {
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "zoom": {
          "type": "number"
        },
        "bearing": {
          "const": 0
        },
        "pitch": {
          "const": 0
        },
        "minZoom": {
          "type": "number"
        },
        "maxZoom": {
          "type": "number"
        },
        "bounds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "limitToExtent": {
          "type": "boolean"
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "parentId"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": "integer"
          },
          "expanded": {
            "type": "boolean"
          },
          "toggleable": {
            "type": "boolean"
          },
          "initialVisibility": {
            "type": "boolean"
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "groupId",
          "initialVisibility",
          "componentIds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "geometry": {
            "enum": [
              "point",
              "line",
              "polygon",
              "raster",
              "unknown"
            ]
          },
          "initialVisibility": {
            "type": "boolean"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "legend": {
            "type": "boolean"
          },
          "labelAlways": {
            "type": "boolean"
          },
          "snap": {
            "type": "boolean"
          },
          "featureKeyProperty": {
            "type": [
              "string",
              "null"
            ]
          },
          "identityScope": {
            "enum": [
              "persistent",
              "export"
            ]
          },
          "popupFields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "title",
                "type"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          },
          "filterFields": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "searchable": {
            "type": "boolean"
          },
          "deepLinks": {
            "type": "boolean"
          },
          "minZoom": {
            "type": "number"
          },
          "maxZoom": {
            "type": "number"
          },
          "ruleIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "componentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "swatch": {
            "type": [
              "string",
              "null"
            ]
          },
          "toggleable": {
            "type": "boolean"
          },
          "heightField": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "layerId",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "layerId": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "swatch": {
            "type": [
              "string",
              "null"
            ]
          },
          "minZoom": {
            "type": "number"
          },
          "maxZoom": {
            "type": "number"
          },
          "order": {
            "type": "integer"
          },
          "componentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "layerId",
          "styleLayerIds",
          "sourceId"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "geometry",
              "decoration",
              "label",
              "callout",
              "helper",
              "raster"
            ]
          },
          "layerId": {
            "type": "string"
          },
          "ruleIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "styleLayerIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceId": {
            "type": "string"
          },
          "sourceLayer": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependsOnSourceLayers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interactive": {
            "type": "boolean"
          }
        }
      }
    },
    "search": {
      "type": [
        "object",
        "null"
      ]
    },
    "featureLookup": {
      "type": [
        "object",
        "null"
      ]
    },
    "interaction": {
      "type": "object"
    },
    "tools": {
      "type": "object"
    },
    "diagnostics": {
      "type": [
        "string",
        "null"
      ]
    },
    "generator": {
      "type": "object"
    },
    "crs": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "authid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "proj": {
          "type": "string"
        },
        "geographic": {
          "type": "boolean"
        },
        "units": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "basemap": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "source",
        "flavors",
        "initial",
        "attribution"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "id",
                "kind",
                "tileType",
                "href"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "const": "q2vt_basemap"
                },
                "kind": {
                  "const": "pmtiles"
                },
                "tileType": {
                  "const": "mvt"
                },
                "href": {
                  "$ref": "#/$defs/relPath"
                },
                "minTileZoom": {
                  "type": "integer"
                },
                "maxTileZoom": {
                  "type": "integer"
                },
                "bounds": {
                  "type": "array"
                },
                "sha256": {
                  "type": "string"
                },
                "sizeBytes": {
                  "type": "integer"
                }
              }
            }
          ]
        },
        "flavors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "style"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "light",
                  "dark",
                  "white",
                  "grayscale",
                  "black"
                ]
              },
              "title": {
                "type": "string"
              },
              "style": {
                "$ref": "#/$defs/relPath"
              },
              "colors": {
                "type": "object"
              }
            }
          }
        },
        "initial": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "xyz": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "tiles"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^xyz-[0-9]+$"
              },
              "title": {
                "type": "string"
              },
              "tiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^https://"
                }
              },
              "scheme": {
                "enum": [
                  "xyz",
                  "tms"
                ]
              },
              "attribution": {
                "type": "string"
              },
              "minzoom": {
                "type": "integer"
              },
              "maxzoom": {
                "type": "integer"
              },
              "tileSize": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "themes": {
      "type": "object",
      "required": [
        "presets"
      ],
      "additionalProperties": false,
      "properties": {
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "layers"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^th-"
              },
              "title": {
                "type": "string"
              },
              "layers": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "groups": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "rules": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "initial": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "parcelInfo": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "manifest",
        "catalog",
        "layerId"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/relPath"
        },
        "catalog": {
          "$ref": "#/$defs/relPath"
        },
        "layerId": {
          "type": "string"
        },
        "records": {
          "type": "integer"
        },
        "zoningLayerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "zoneCodeField": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "info": {
      "type": [
        "object",
        "null"
      ]
    },
    "terrain": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "$defs": {
    "relPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|\\.\\.|\\\\|^[A-Za-z]:|://)"
      }
    }
  }
}
